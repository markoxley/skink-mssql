// File:    ms_pkt.skink
// Purpose: TDS packet framing for SQL Server. Every packet is an
//          8-byte header followed by payload:
//            u8 type | u8 status | u16be length (incl. header)
//            u16be spid | u8 packetid | u8 window
//          Messages spanning multiple packets set status bit 0x01
//          (EOM) on the last packet only. Payload reads/writes are
//          length-explicit — TDS is binary-safe throughout.
//
//          Also provides the little-endian Reader/OutBuf the token
//          layer needs (TDS data is LE; only the packet header's
//          length/SPID fields are big-endian).
module ms_pkt

import "std/str"
import "std/libc"
import "std/errors"
import "mod/markoxley/skink-dbx/dbx_bufconn"

// packet types
pub const PT_SQL_BATCH   = 0x01
pub const PT_RPC         = 0x03
pub const PT_RESPONSE    = 0x04
pub const PT_ATTENTION   = 0x06
pub const PT_BULK        = 0x07
pub const PT_TXN         = 0x0E
pub const PT_LOGIN7      = 0x10
pub const PT_PRELOGIN    = 0x12

// status bits
pub const ST_NORMAL   = 0x00
pub const ST_EOM      = 0x01
pub const ST_RESETCON = 0x08

// default negotiated packet size
pub const PACKET_SIZE = 4096

// ---- little-endian cursor ----------------------------------------------------

// Reader is a byte cursor over a payload.
pub struct Reader {
    Body: string
    Len:  int
    Pos:  int
}

// NewReader wraps a buffer.
pub fn NewReader(body: string, n: int) -> Reader {
    return Reader{Body: body, Len: n, Pos: 0}
}

// Remaining bytes left.
pub fn Remaining(r: *Reader) -> int {
    return r.Len - r.Pos
}

// RByte reads one byte.
pub fn RByte(r: *Reader) -> int {
    if r.Pos >= r.Len {
        return 0
    }
    c := int(r.Body[r.Pos])
    r.Pos = r.Pos + 1
    if c < 0 {
        return c + 256
    }
    return c
}

// RI16/RI32/RI64 read little-endian integers.
pub fn RI16(r: *Reader) -> int {
    if r.Pos + 2 > r.Len {
        return 0
    }
    v := int(r.Body[r.Pos]) | (int(r.Body[r.Pos + 1]) << 8)
    r.Pos = r.Pos + 2
    return v
}

pub fn RI32(r: *Reader) -> int64 {
    if r.Pos + 4 > r.Len {
        return int64(0)
    }
    v := int64(r.Body[r.Pos]) | (int64(r.Body[r.Pos + 1]) << 8) |
        (int64(r.Body[r.Pos + 2]) << 16) | (int64(r.Body[r.Pos + 3]) << 24)
    r.Pos = r.Pos + 4
    return v
}

pub fn RI64(r: *Reader) -> int64 {
    lo := RI32(r)
    hi := RI32(r)
    return (hi << 32) | (lo & int64(4294967295))
}

// RBytes copies out n bytes.
pub fn RBytes(r: *Reader, n: int) -> string {
    if n < 0 || r.Pos + n > r.Len {
        n = r.Len - r.Pos
        if n < 0 {
            n = 0
        }
    }
    out := libc.malloc(n + 1)
    libc.memcpy(out, string(int64(r.Body) + int64(r.Pos)), n)
    out[n] = 0
    r.Pos = r.Pos + n
    return out
}

// RUcs2 reads n UTF-16LE bytes → UTF-8/ASCII (BMP subset; the driver
// only produces BMP chars anyway). The count is clamped to the bytes
// actually remaining so a malformed declared length can't read past
// the payload.
pub fn RUcs2(r: *Reader, nbytes: int) -> string {
    avail := r.Len - r.Pos
    if avail < 0 {
        avail = 0
    }
    if nbytes > avail {
        nbytes = avail
    }
    if nbytes < 0 {
        nbytes = 0
    }
    chars := nbytes / 2
    out := libc.malloc(chars * 3 + 1)
    o := 0
    for i := 0; i < chars; i = i + 1 {
        lo := int(r.Body[r.Pos + i * 2]) & 255
        hi := int(r.Body[r.Pos + i * 2 + 1]) & 255
        cp := lo | (hi << 8)
        if cp < 128 {
            out[o] = cp
            o = o + 1
        } else if cp < 2048 {
            out[o] = 192 | (cp >> 6)
            out[o + 1] = 128 | (cp & 63)
            o = o + 2
        } else {
            out[o] = 224 | (cp >> 12)
            out[o + 1] = 128 | ((cp >> 6) & 63)
            out[o + 2] = 128 | (cp & 63)
            o = o + 3
        }
    }
    r.Pos = r.Pos + nbytes
    out[o] = 0
    return out
}

// ---- OutBuf ------------------------------------------------------------------

// OutBuf accumulates a packet payload (explicit length — NUL-safe).
pub struct OutBuf {
    Buf: string
    Len: int
    Cap: int
}

// NewOutBuf allocates a buffer.
pub fn NewOutBuf(cap: int) -> OutBuf {
    if cap < 64 {
        cap = 64
    }
    return OutBuf{Buf: libc.malloc(cap), Len: 0, Cap: cap}
}

// Free releases the buffer.
pub fn Free(b: *OutBuf) {
    libc.free(b.Buf)
    b.Buf = ""
    b.Len = 0
    b.Cap = 0
}

// grow ensures n more bytes fit.
fn grow(b: *OutBuf, n: int) {
    if b.Len + n <= b.Cap {
        return
    }
    cap := b.Cap * 2
    for cap < b.Len + n {
        cap = cap * 2
    }
    nb := libc.malloc(cap)
    libc.memcpy(nb, b.Buf, b.Len)
    libc.free(b.Buf)
    b.Buf = nb
    b.Cap = cap
}

// Byte appends one byte.
pub fn Byte(b: *OutBuf, c: int) {
    grow(b, 1)
    b.Buf[b.Len] = c & 255
    b.Len = b.Len + 1
}

// WriteN appends exactly n bytes (NUL-safe).
pub fn WriteN(b: *OutBuf, s: string, n: int) {
    grow(b, n)
    libc.memcpy(string(int64(b.Buf) + int64(b.Len)), s, n)
    b.Len = b.Len + n
}

// I16/I32/I64 append little-endian integers.
pub fn I16(b: *OutBuf, v: int) {
    grow(b, 2)
    b.Buf[b.Len] = v & 255
    b.Buf[b.Len + 1] = (v >> 8) & 255
    b.Len = b.Len + 2
}

pub fn I32(b: *OutBuf, v: int64) {
    grow(b, 4)
    for i := 0; i < 4; i = i + 1 {
        b.Buf[b.Len + i] = int((v >> (i * 8)) & int64(255))
    }
    b.Len = b.Len + 4
}

pub fn I64(b: *OutBuf, v: int64) {
    grow(b, 8)
    for i := 0; i < 8; i = i + 1 {
        b.Buf[b.Len + i] = int((v >> (i * 8)) & int64(255))
    }
    b.Len = b.Len + 8
}

// Ucs2 appends s encoded as UTF-16LE (BMP only — non-ASCII inputs are
// rare in DSNs/passwords; full surrogate support is out of scope).
pub fn Ucs2(b: *OutBuf, s: string) {
    n := str.Len(s)
    i := 0
    for i < n {
        c := int(s[i]) & 255
        if c < 128 {
            I16(b, c)
            i = i + 1
        } else if c < 224 {
            cp := ((c & 31) << 6) | (int(s[i + 1]) & 63)
            I16(b, cp)
            i = i + 2
        } else if c < 240 {
            cp := ((c & 15) << 12) | ((int(s[i + 1]) & 63) << 6) | (int(s[i + 2]) & 63)
            I16(b, cp)
            i = i + 3
        } else {
            // 4-byte UTF-8 → not representable in UCS-2; emit '?'.
            I16(b, 63)
            i = i + 4
        }
    }
}

// ---- packet I/O --------------------------------------------------------------

// Send writes payload as one or more packets of the given type. The
// last fragment gets the EOM bit.
pub fn Send(bc: *dbx_bufconn.BufConn, ptype: int, payload: string, plen: int) -> errors.Error {
    maxPayload := PACKET_SIZE - 8
    pos := 0
    pktID := 1
    for {
        chunk := plen - pos
        last := true
        if chunk > maxPayload {
            chunk = maxPayload
            last = false
        }
        b := NewOutBuf(chunk + 8)
        Byte(&b, ptype)
        if last {
            Byte(&b, ST_EOM)
        } else {
            Byte(&b, ST_NORMAL)
        }
        // big-endian length + spid
        total := chunk + 8
        Byte(&b, (total >> 8) & 255)
        Byte(&b, total & 255)
        Byte(&b, 0)
        Byte(&b, 0)
        Byte(&b, pktID & 255)
        Byte(&b, 0)
        WriteN(&b, string(int64(payload) + int64(pos)), chunk)
        err := bc.WriteAll(b.Buf, b.Len)
        Free(&b)
        if str.Len(err.message) > 0 {
            return err
        }
        pos = pos + chunk
        pktID = pktID + 1
        if last {
            return errors.New("")
        }
    }
    return errors.New("")
}

// Recv reads packets until EOM and returns the concatenated payload
// plus its length and the first packet's type.
pub fn Recv(bc: *dbx_bufconn.BufConn) -> (string, int, int, errors.Error) {
    var out string
    outLen := 0
    ptype := 0
    first := true
    for {
        hdr, herr := bc.ReadN(8)
        if str.Len(herr.message) > 0 {
            libc.free(out)
            return "", 0, 0, herr
        }
        r := NewReader(hdr, 8)
        t := RByte(&r)
        status := RByte(&r)
        // header length/SPID are big-endian
        hi := RByte(&r)
        lo := RByte(&r)
        plen := (hi << 8) | lo
        RByte(&r)
        RByte(&r)
        RByte(&r)
        RByte(&r)
        if first {
            ptype = t
            first = false
        }
        payLen := plen - 8
        if payLen < 0 {
            libc.free(out)
            return "", 0, 0, errors.New("tds: bad packet length")
        }
        body, berr := bc.ReadN(payLen)
        if str.Len(berr.message) > 0 {
            libc.free(out)
            return "", 0, 0, berr
        }
        if outLen + payLen > 268435456 { // 256 MiB cumulative cap
            libc.free(out)
            libc.free(body)
            return "", 0, 0, errors.New("tds: response too large")
        }
        nb := libc.malloc(outLen + payLen + 1)
        if outLen > 0 {
            libc.memcpy(nb, out, outLen)
            libc.free(out)
        }
        libc.memcpy(string(int64(nb) + int64(outLen)), body, payLen)
        nb[outLen + payLen] = 0
        out = nb
        outLen = outLen + payLen
        libc.free(body)
        if (status & ST_EOM) != 0 {
            return out, outLen, ptype, errors.New("")
        }
    }
    return out, outLen, ptype, errors.New("")
}
